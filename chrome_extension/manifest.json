{
  "manifest_version": 3,
  "name": "Gemini Gems Dashboard Sync",
  "version": "1.0.0",
  "description": "Sincroniza automaticamente os teus Gemini Gems para o teu Dashboard Notion-style.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
